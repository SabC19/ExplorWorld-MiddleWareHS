<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC 
"-//Hibernate/Hibernate Configuration DTD 3.0//EN" 
"http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/explorworld?serverTimezone=UTC
        </property>

        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">abc123..</property>

        <property name="hibernate.dialect">
            org.hibernate.dialect.MySQL8Dialect
        </property>

        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <mapping class="com.explorworld.model.Province"/>
     	<mapping class="com.explorworld.model.Locality"/>
     	<mapping class="com.explorworld.model.Place"/>
     	<mapping class="com.explorworld.model.Gender"/>
     	<mapping class="com.explorworld.model.Guide"/>
     	<mapping class="com.explorworld.model.ActivityType"/>
     	<mapping class="com.explorworld.model.Transport"/>
     	<mapping class="com.explorworld.model.TransportType"/>
     	<mapping class="com.explorworld.model.EquipmentType"/>
     	<mapping class="com.explorworld.model.Participant"/>
     	<mapping class="com.explorworld.model.Activity"/>
     	<mapping class="com.explorworld.model.Ticket"/>
     	<mapping class="com.explorworld.model.Payment"/>
     	<mapping class="com.explorworld.model.PaymentMethod"/>

    </session-factory>
</hibernate-configuration>
